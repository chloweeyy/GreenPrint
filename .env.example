# Copy to .env and replace every value. Never commit .env.
GREENPRINT_DB_HOST=your-project.pooler.supabase.com
GREENPRINT_DB_PORT=5432
GREENPRINT_DB_NAME=postgres
GREENPRINT_DB_USER=postgres.your-project-ref
GREENPRINT_DB_PASSWORD=replace-with-a-new-database-password
GREENPRINT_DB_SSLMODE=require
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
GEMINI_API_KEY=your-new-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash
GREENPRINT_DEVICE_KEY=generate-a-long-random-device-key
GREENPRINT_TIMEZONE=Asia/Manila
GREENPRINT_ADMIN_USERNAME=admin
GREENPRINT_ADMIN_PASSCODE=replace-with-a-strong-initial-passcode
GREENPRINT_CHECKOUT_PIN=replace-with-a-unique-4-to-8-digit-pin
